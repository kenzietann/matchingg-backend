{
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/postgres": "^6.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/redis": "^8.0.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.9.0",
    "mammoth": "^1.12.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.1",
    "tesseract.js": "^7.0.0",
    "typeorm": "^0.3.30",
    "typeorm-fastify-plugin": "^4.0.0"
  },
  "type": "module",
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@swc/helpers": "^0.5.23",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.0.1",
    "@typescript/typescript6": "^6.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate ./migrations/Migration -d ./plugins/database.ts",
    "migration:run": "npm run typeorm -- migration:run -d ./plugins/database.ts",
    "migration:create": "npm run typeorm -- migration:create ./migrations/ManualMigration",
    "migration:revert": "npm run typeorm -- migration:revert -d ./plugins/database.ts",
    "start": "NODE_ENV=production tsx server.ts"
  }
}
